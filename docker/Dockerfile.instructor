# =============================================================================
# DeMiAn instructor server (Qwen3.5-2B instructor) — used by the async-instructor
# eval (openpi/scripts/eval/qwen_instructor_server.py).
#
# Kept SEPARATE from the policy image on purpose: the qwen3_5 model type needs a
# newer `transformers` than the pi05 policy's pinned 4.53.2. At eval the policy
# image serves the action policy and this image serves the instructor; they talk
# over HTTP and can co-host on one GPU (~10 GB total).
#
# Build:
#   docker build -f docker/Dockerfile.instructor -t demian-instructor:latest .
# =============================================================================
ARG BASE_IMAGE=nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3-pip git && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python3 && \
    rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip && \
    python -m pip install --index-url https://download.pytorch.org/whl/cu124 torch==2.7.1

# Newest transformers (qwen3_5 support) + the instructor runtime deps. Pin to the
# transformers version the instructor checkpoint was exported with if needed
# (checkpoints/instructor/*/config.json records `transformers_version`).
RUN python -m pip install \
        "transformers>=5.0" accelerate "huggingface-hub>=0.30.0,<1.0" \
        pillow numpy sentencepiece "qwen-vl-utils>=0.0.14"

WORKDIR /workspace
# Serve with, e.g.:
#   python openpi/scripts/eval/qwen_instructor_server.py \
#       --model-path checkpoints/instructor/molmospaces --port 8001 --device cuda:0
